# Copy this file to .env and fill in the values. .env is never committed or baked into the image.

# Required: TypeSafe Jev API key (https://typesafe.ai)
TYPESAFE_API_KEY=

# Database for accounts, API keys and usage. Default: a local SQLite file (backend/data/).
# Production: a free Neon Postgres connection string, pasted as-is.
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/promptlint?sslmode=require

# Required in production: a long random string used to hash prompts in usage logs.
# PROMPT_HASH_SALT=

# Required in production for "Connected LLM providers" (routing that calls models): a long random string
# that encrypts the provider keys users save. Without it, saving keys is disabled (per-request keys still
# work). Local SQLite uses a built-in dev secret. Don't change it once keys are saved.
# PROVIDER_KEY_SECRET=

# Optional: let custom endpoints point at private/local addresses such as http://localhost:11434 (Ollama).
# Default: allowed with local SQLite, blocked in production (so users can't reach your server's network).
# ALLOW_PRIVATE_PROVIDER_URLS=false

# Optional, free: Cloudflare Turnstile captcha on sign-up (both keys, or neither).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional: pin a different Jev model (re-run the evals when you change it)
# JEV_MODEL=jev-1.13.0

# Optional: exact input-token counts for Claude and Gemini models in the cost table.
# Without them those rows show an "≈" estimate (chars / 4).
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Optional: limits
# RATE_LIMIT=20/hour
# QUIZ_RATE_LIMIT=5/hour               # quiz submissions per IP (each costs ~10 Jev calls)
# PROVIDER_TIMEOUT_S=120               # how long /v1/route waits for an LLM before trying the backup
# MAX_PROMPT_CHARS=20000
# RATE_LIMIT_STORAGE=memory://          # fine for one instance; redis://… only if you scale out
# ALLOWED_ORIGINS=                      # comma-separated, only if a frontend on another domain calls the API

# Eval only (eval/run_first_try.py): the LLM that answers prompts and judges the answers.
# GROQ_API_KEY=
